{
  "name": "punchlist-pay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts && tsx scripts/smoke-backend.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/seed.ts --migrate-only",
    "db:seed": "tsx db/seed.ts",
    "smoke:live": "tsx scripts/smoke-backend.ts --live",
    "test:unit": "tsx scripts/paypal-unit.ts && tsx scripts/agents-unit.ts && tsx scripts/db-check.ts",
    "paypal:smoke": "bash scripts/paypal-smoke.sh",
    "eval:verifier": "tsx scripts/verifier-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@electric-sql/pglite": "^0.5.16",
    "@radix-ui/react-dialog": "^1.1.6",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22.x"
  }
}
