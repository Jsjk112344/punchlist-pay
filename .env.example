# Punchlist Pay — environment. Copy to .env.local for local dev; set the same keys on Render.
# Every provider is optional: with a key missing, that layer runs in clearly-labelled fixture mode
# (responses carry X-Punchlist-Mode: fixture and all money ids are prefixed FIXTURE-).

# --- PayPal (REST sandbox app on the PLATFORM business account) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook subscription id for POST /api/paypal/webhook (optional; the 3s poll settles everything without it)
PAYPAL_WEBHOOK_ID=
# Same client id, exposed to the browser for the PayPal JS SDK fund button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox PERSONAL account emails that receive Payouts (seeded into contractors.paypal_email)
CONTRACTOR_EMAIL_MIKE=
CONTRACTOR_EMAIL_SARA=
CONTRACTOR_EMAIL_LEO=

# --- Claude (Dispatcher, Contractor, Verifier agents) ---
ANTHROPIC_API_KEY=
# Optional override; default claude-sonnet-5-5
CLAUDE_MODEL=

# --- Persistence ---
# Postgres connection string (Neon / Render Postgres). Leave empty to use embedded PGlite under PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=data/pglite

# --- App ---
APP_URL=http://localhost:3000
# Proof photo storage (Render persistent disk mount in prod)
UPLOAD_DIR=uploads
